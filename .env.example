# URL WebSocket Server cho chế độ Multiplayer khi deploy lên Vercel / Production.
# Nếu chạy ở local (npm run dev), để trống thì game sẽ tự động kết nối vào server nội bộ ws://localhost:5173/ws.
# Khi deploy Vercel, hãy deploy server/server.js lên Render.com hoặc Railway.app rồi dán link WebSocket vào đây:
# Ví dụ:
# VITE_WS_URL=wss://doggame-server.onrender.com/ws
VITE_WS_URL=
